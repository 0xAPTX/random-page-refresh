{
  "manifest_version": 3,
  "name": "随机刷新",
  "version": "1.0.0",
  "description": "每次从 10–20 分钟随机抽取一个间隔，自动刷新你选中的网页。",
  "minimum_chrome_version": "111",
  "permissions": ["activeTab", "alarms", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "随机刷新",
    "default_popup": "popup.html"
  }
}
